{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:previews": "concurrently -k -n vite,previews -c cyan,magenta \"vite\" \"php artisan sve:previews --watch\"",
        "watch": "vite",
        "cp:dev": "vite --config vite-cp.config.js",
        "cp:build": "vite build --config vite-cp.config.js",
        "browser": "PUPPETEER_CACHE_DIR=storage/app/sve-browser/puppeteer puppeteer browsers install chrome-headless-shell"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.4",
        "alpinejs": "^3.15.11",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^3.0.1",
        "puppeteer": "^25.5.0",
        "tailwindcss": "^4.2.4",
        "vite": "^8.0.10"
    },
    "dependencies": {
        "@cursor/sdk": "^1.0.30",
        "@statamic/cms": "file:./vendor/statamic/cms/resources/dist-package"
    }
}
